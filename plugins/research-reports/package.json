{
  "name": "@local/research-reports",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Browse this project's research reports by target: pin and reorder targets, and read any report inside the panel.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./markdown": "./markdown.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "markdown.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "test"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
